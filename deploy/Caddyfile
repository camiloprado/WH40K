{
	admin off
}

# HTTP em loopback. Na frente: `tailscale serve --bg --https=443 http://127.0.0.1:18081`
# Nunca usar `tailscale funnel`. Certificado *.ts.net fica com o Tailscale (sem tls internal).
:80 {
	encode gzip
	request_body {
		max_size 200KB
	}
	header {
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /api/v1/restore {
		request_body {
			max_size 20MB
		}
		reverse_proxy api:8000
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
